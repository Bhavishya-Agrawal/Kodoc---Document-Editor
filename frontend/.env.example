# Kodoc Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
# For local development:
VITE_BACKEND_URL=http://localhost:5000

# For production on Vercel (same-origin monorepo deployment):
# Leave this EMPTY or remove it — the app auto-detects same-origin.
# VITE_BACKEND_URL=

# For separate backend deployment (e.g. Render, Railway):
# VITE_BACKEND_URL=https://your-backend-url.onrender.com
