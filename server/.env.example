# Kodoc Backend — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/kodoc
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kodoc
MONGO_URI=mongodb://127.0.0.1:27017/kodoc

# JWT secret key for authentication tokens
# Use a strong random string in production
JWT_SECRET=your_jwt_secret_here

# Server port (Vercel ignores this, only used for local dev)
PORT=5000

# Node environment
NODE_ENV=development

# Frontend URL (for CORS whitelist in production)
# FRONTEND_URL=https://kodoc.vercel.app
